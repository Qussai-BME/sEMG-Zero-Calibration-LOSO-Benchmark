# Local run bookkeeping (auto-regenerated by validation/01a_run_loso_benchmark.py
# and validation/02d_run_full_ablation_suite.py; not part of the citable results)
validation/backups/
validation/results/_run_progress.json
validation/results/_day2_window_progress.json
validation/results/_day2_feature_progress.json

# Top-level data/, notebooks/, results/ are local-only and intentionally not
# published: they hold a leftover ~250MB third-party EMG dataset unrelated to
# NinaPro, a demo notebook that imports a module no longer in this repo, and
# generic sample files from an earlier, unrelated prototype. The actual
# pipeline lives entirely under validation/ (see validation/results/ for the
# real, citable outputs). Remove this rule if you intentionally add real
# content here later.
/data/
/notebooks/
/results/
